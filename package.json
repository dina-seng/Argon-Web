{
  "name": "argon",
  "version": "0.1.0",
  "private": true,
  "description": "Argon – Cambodian event discovery and QR ticketing platform",
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module", 
  "scripts": {
    "dev": "npm run dev --workspace=apps/web & npm run dev --workspace=apps/scanner & npm run dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:scanner": "npm run build --workspace=apps/scanner",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.11.10",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}