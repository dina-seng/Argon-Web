# API Environment Variables
# Copy this file to .env and fill in real values. DO NOT commit .env

DATABASE_URL=postgresql://argon:argon_local_secret@localhost:5432/argon_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
CLIENT_URL=http://localhost:5173
SCANNER_URL=http://localhost:5174
QR_SIGNING_SECRET=replace_with_a_32_byte_hex_secret
PAYMENT_GATEWAY_BASE_URL=https://sandbox.payment-gateway.example.com
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signing_secret
PORT=3000
NODE_ENV=development
